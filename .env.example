# Gemini (GEMINI_API_KEY ưu tiên, GOOGLE_API_KEY cũng được)
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.5-flash-lite

# Window ẢO để buộc compaction xảy ra trong demo (model thật có window lớn hơn nhiều)
CTXB_CONTEXT_WINDOW=64000
CTXB_OUTPUT_RESERVE=4000
# Ngưỡng utilization: micro = chỉ prune (không gọi LLM), full = tạo checkpoint
CTXB_MICRO_THRESHOLD=0.5
CTXB_FULL_THRESHOLD=0.7
# Full compaction giữ nguyên văn N lượt gần nhất; prune không đụng N tool message gần nhất
CTXB_KEEP_RECENT_TURNS=1
CTXB_KEEP_RECENT_STEPS=2
# Chỉ gọi LLM tạo checkpoint khi phần nén được >= số token này
CTXB_MIN_COMPACT_GAIN=3000
# Giới hạn token của MỘT tool result khi vào context (phần thừa được archive)
CTXB_TOOL_RESULT_CAP=6000

# Code Mode
CTXB_CODE_TIMEOUT=10
CTXB_CODE_OUTPUT_CAP=2000

# Thư mục dữ liệu (workspace giả, archive, reports). Mặc định: ./runs
CTXB_RUNS_DIR=
